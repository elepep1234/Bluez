    UIPadding.Parent = ScrollFrame
    
    return {
        MainFrame = MainFrame,
        ScrollFrame = ScrollFrame,
        ScreenGui = ScreenGui
    }
end

function UIModule:CreateToggle(parent, text, settingKey, callback)
    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(1, 0, 0, 30)
    toggleFrame.BackgroundTransparency = 1
    toggleFrame.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.white
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.Parent = toggleFrame
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0.25, 0, 0.7, 0)
    button.Position = UDim2.new(0.72, 0, 0.15, 0)
    button.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    button.Text = "OFF"
    button.TextColor3 = Color3.white
    button.TextSize = 12
    button.Font = Enum.Font.Gotham
    button.Parent = toggleFrame
    
    local function UpdateToggle()
        local state = Settings[settingKey]
        if state then
            button.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
            button.Text = "ON"
        else
            button.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            button.Text = "OFF"
        end
        if callback then callback(state) end
    end
    
    button.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        UpdateToggle()
    end)
    
    UpdateToggle()
end

-- ============================================================================
-- INICIALIZACIÓN
-- ============================================================================
function BloxFruits:Init()
    local UI = UIModule:Create()
    local scrollFrame = UI.ScrollFrame
    
    -- Auto Farm
    UIModule:CreateToggle(scrollFrame, "Auto Farm", "AutoFarm", function(state)
        Settings.AutoFarm = state
        if state then
            FarmModule:Start()
        else
            FarmModule:Stop()
        end
    end)
    
    UIModule:CreateToggle(scrollFrame, "Auto Skills", "AutoSkills", function(state)
        Settings.AutoSkills = state
    end)
    
    UIModule:CreateToggle(scrollFrame, "Noclip", "Noclip", function(state)
        Settings.Noclip = state
    end)
    
    -- Skills
    UIModule:CreateToggle(scrollFrame, "Skill Z", "SkillZ", function(state)
        Settings.SkillZ = state
    end)
    
    UIModule:CreateToggle(scrollFrame, "Skill X", "SkillX", function(state)
        Settings.SkillX = state
    end)
    
    UIModule:CreateToggle(scrollFrame, "Skill C", "SkillC", function(state)
        Settings.SkillC = state
    end)
    
    UIModule:CreateToggle(scrollFrame, "Skill V", "SkillV", function(state)
        Settings.SkillV = state
    end)
    
    UIModule:CreateToggle(scrollFrame, "Skill F", "SkillF", function(state)
        Settings.SkillF = state
    end)
    
    -- Controles
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            UI.MainFrame.Visible = not UI.MainFrame.Visible
        end
    end)
    
    print("✅ Blox Fruits Hub CARGADO!")
    print("🎮 Presiona RIGHT SHIFT para abrir/cerrar menú")
end

-- Iniciar
BloxFruits:Init()
