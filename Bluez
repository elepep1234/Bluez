-- Blox Fruits Script FIXED
local BloxFruits = {}

-- Servicios
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Workspace = game:GetService("Workspace")

-- Jugador
local Player = Players.LocalPlayer

-- Configuración
local Settings = {
    AutoFarm = false,
    AutoSkills = false,
    SkillZ = true,
    SkillX = true,
    SkillC = true,
    SkillV = true,
    SkillF = true,
    WalkSpeed = 50,
    JumpPower = 100,
    Noclip = false,
    BringMobs = true,
    AutoClick = false
}

-- ============================================================================
-- MÓDULO AUTO FARM (SIMPLIFICADO)
-- ============================================================================
local FarmModule = {
    Connection = nil
}

function FarmModule:Start()
    if self.Connection then
        self.Connection:Disconnect()
    end
    
    self.Connection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoFarm then return end
        
        local character = Player.Character
        if not character then return end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        -- Buscar NPC más cercano
        local target = nil
        local nearestDistance = math.huge
        
        for _, npc in pairs(Workspace:GetChildren()) do
            if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                if npc:FindFirstChild("HumanoidRootPart") then
                    local distance = (rootPart.Position - npc.HumanoidRootPart.Position).Magnitude
                    if distance < nearestDistance and distance < 200 then
                        nearestDistance = distance
                        target = npc
                    end
                end
            end
        end
        
        if target then
            -- Teletransportarse al NPC
            local targetPos = target.HumanoidRootPart.Position
            rootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 10, -5))
            
            -- Usar habilidades
            if Settings.AutoSkills then
                FarmModule:UseSkills()
            end
            
            -- Auto click
            if Settings.AutoClick then
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        end
    end)
end

function FarmModule:UseSkills()
    local skills = {
        {key = Enum.KeyCode.Z, enabled = Settings.SkillZ},
        {key = Enum.KeyCode.X, enabled = Settings.SkillX},
        {key = Enum.KeyCode.C, enabled = Settings.SkillC},
        {key = Enum.KeyCode.V, enabled = Settings.SkillV},
        {key = Enum.KeyCode.F, enabled = Settings.SkillF}
    }
    
    for _, skill in pairs(skills) do
        if skill.enabled then
            VirtualInputManager:SendKeyEvent(true, skill.key, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, skill.key, false, game)
        end
    end
end

function FarmModule:Stop()
    if self.Connection then
        self.Connection:Disconnect()
        self.Connection = nil
    end
end

-- ============================================================================
-- INTERFAZ CORREGIDA
-- ============================================================================
local UIModule = {}

