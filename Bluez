-- ============================================================================
-- MÓDULO AUTO FARM BLOX FRUITS
-- ============================================================================
local FarmModule = {
    Connection = nil,
    CurrentTarget = nil
}

function FarmModule:Start()
    if self.Connection then
        self.Connection:Disconnect()
    end
    
    self.Connection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoFarm then return end
        
        local character = Player.Character
        if not character then return end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        
        if not humanoid or not rootPart or humanoid.Health <= 0 then return end
        
        -- Buscar NPCs en Blox Fruits
        local target = self:FindNearestNPC()
        if target then
            self:TeleportToTarget(target)
            self:UseSkills()
            self:ClickAttack()
            
            if Settings.BringMobs then
                self:BringNearbyMobs(target)
            end
        end
    end)
end

function FarmModule:FindNearestNPC()
    local character = Player.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local nearestNPC = nil
    local nearestDistance = math.huge
    
    -- Lugares donde buscar NPCs en Blox Fruits
    local searchFolders = {
        Workspace:FindFirstChild("Enemies"),
        Workspace:FindFirstChild("_ENEMIES"),
        Workspace:FindFirstChild("NPCs"),
        Workspace:FindFirstChild("Live")
    }
    
    for _, folder in pairs(searchFolders) do
        if folder then
            for _, npc in pairs(folder:GetChildren()) do
                if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                    if npc:FindFirstChild("HumanoidRootPart") then
                        local distance = (rootPart.Position - npc.HumanoidRootPart.Position).Magnitude
                        if distance < nearestDistance and distance < 500 then
                            nearestDistance = distance
                            nearestNPC = npc
                        end
                    end
                end
            end
        end
    end
    
    return nearestNPC
end

function FarmModule:TeleportToTarget(target)
    local character = Player.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local targetPos = target.HumanoidRootPart.Position
    local farmPosition = targetPos + Vector3.new(0, 10, -5) -- Posición óptima para farmear
    
    -- Usar CFrame para teletransporte suave
    rootPart.CFrame = CFrame.new(farmPosition)
end

function FarmModule:UseSkills()
    if not Settings.AutoSkills then return end
    
    -- Skills de Blox Fruits (Z, X, C, V, F)
    local skills = {
        {key = Enum.KeyCode.Z, enabled = Settings.SkillZ},
        {key = Enum.KeyCode.X, enabled = Settings.SkillX},
        {key = Enum.KeyCode.C, enabled = Settings.SkillC},
        {key = Enum.KeyCode.V, enabled = Settings.SkillV},
        {key = Enum.KeyCode.F, enabled = Settings.SkillF}
    }
    
    for _, skill in pairs(skills) do
        if skill.enabled then
            VirtualInputManager:SendKeyEvent(true, skill.key, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, skill.key, false, game)
            task.wait(0.2)
        end
    end
end

function FarmModule:ClickAttack()
    if Settings.AutoClick then
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end
end

function FarmModule:BringNearbyMobs(target)
    if not Settings.BringMobs then return end
    
    local targetPos = target.HumanoidRootPart.Position
    
    for _, npc in pairs(Workspace:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
            if npc:FindFirstChild("HumanoidRootPart") then
                local distance = (npc.HumanoidRootPart.Position - targetPos).Magnitude
                if distance < 300 then
                    npc.HumanoidRootPart.CFrame = CFrame.new(targetPos)
                end
            end
        end
    end
end

function FarmModule:Stop()
    if self.Connection then
        self.Connection:Disconnect()
        self.Connection = nil
    end
end

